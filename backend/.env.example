XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Set to whatever model id xAI exposes (e.g. grok-4-latest, grok-4.3).
XAI_MODEL=grok-4-latest
XAI_ZERO_DATA_RETENTION=true

CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
TOP_K=6

OCR_ENABLED=true
OCR_LANG=eng
OCR_DPI=300
